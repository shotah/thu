{
  "name": "thu",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && node --env-file=.env ./node_modules/wrangler/bin/wrangler.js deploy",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm test && npm run lint && npm run typecheck"
  },
  "dependencies": {
    "lottie-web": "^5.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  },
  "overrides": {
    "eslint": { "minimatch": "11.0.4" },
    "@eslint/config-array": { "minimatch": "11.0.4" },
    "@typescript-eslint/typescript-estree": { "minimatch": "11.0.4" },
    "glob": { "minimatch": "11.0.4" },
    "workbox-build": { "glob": "14.0.3" }
  }
}
